section \<open>Class relations and arities\<close>

theory Thm_Classes
  imports Thm_Derivable
begin

text \<open>
  \<open>Thm.add_classrel\<close> and \<open>Thm.add_arity\<close> extend the sort algebra of a theory by a class relation
  \<open>c\<^sub>1 \<subseteq> c\<^sub>2\<close> or an arity \<open>t :: (S\<^sub>1, \<dots>, S\<^sub>n) c\<close>, given a theorem that states it:
  \<open>OFCLASS(?'a::c\<^sub>1, c\<^sub>2)\<close> or \<open>OFCLASS((?'a\<^sub>1::S\<^sub>1, \<dots>, ?'a\<^sub>n::S\<^sub>n) t, c)\<close> (\<open>Logic.dest_classrel\<close>,
  \<open>Logic.dest_arity\<close>), without hypotheses, flex-flex pairs and sort hypotheses beyond the sorts
  of its proposition (\<open>Thm.plain_prop_of\<close>). In the extended theory more types have a sort, so
  each theorem has more instances; the rule \<open>transfer\<close> of \<^const>\<open>derivable\<close> moves theorems
  there, and their validity then refers to the models of the extended signature.

  This theory shows that the extension keeps the models: a class relation or an arity that a
  valid theorem states holds in the model (\<open>classrel_sound\<close>, \<open>arity_sound\<close>), and a model of a
  signature is a model of every signature with the same classes, constants and axioms whose
  class relations and arities hold in it (\<open>model_ext\<close>). So a theory extended by
  \<open>Thm.add_classrel\<close> or \<open>Thm.add_arity\<close> has the models of the theory before
  (\<open>add_classrel_model\<close>, \<open>add_arity_model\<close>), and is consistent if that one has a model.
  The same holds for the declaration of constants (\<open>is_model_consts\<close>). Theorem
  \<open>extends_by_model\<close> puts these together: every signature that is reached from a signature
  with a model by such steps has that model, so its derivable theorems are valid in it
  (\<open>extends_by_valid\<close>, \<open>extends_by_consistent\<close>).

  The functions of \<open>sorts.ML\<close> that compute the extended algebra are not modelled. The theorems
  assume of the extended algebra what these functions establish: it is well formed (they raise
  an error for a cycle of classes or for arities that are not coregular), its class relation is
  generated by the old one and the new pair, and each of its arities is an old one, or follows
  from an old or the new one by a class relation (the completion of arities).
\<close>


subsection \<open>Class relations and arities that hold in a model\<close>

lemma tm_sorts_mk_of_class [simp]: "tm_sorts (mk_of_class T c) = tsorts T"
  by (simp add: mk_of_class_def)

context pure_model
begin

definition sem_classrel :: "pclass \<Rightarrow> pclass \<Rightarrow> bool" where
  "sem_classrel c1 c2 \<longleftrightarrow> (\<forall>A. une A \<longrightarrow> cls c1 A \<longrightarrow> cls c2 A)"

definition sem_arity :: "name \<Rightarrow> psort list \<Rightarrow> pclass \<Rightarrow> bool" where
  "sem_arity a Ss c \<longleftrightarrow> (\<forall>As. length As = length Ss \<longrightarrow> (\<forall>A\<in>set As. une A) \<longrightarrow>
    (\<forall>i<length Ss. ssem (Ss ! i) (As ! i)) \<longrightarrow> cls c (ucon a As))"

lemma sem_classrel_le: "class_le alg c1 c2 \<Longrightarrow> sem_classrel c1 c2"
  unfolding sem_classrel_def by (blast intro: cls_le)

lemma sem_classrel_trans: "sem_classrel c1 c2 \<Longrightarrow> sem_classrel c2 c3 \<Longrightarrow> sem_classrel c1 c3"
  unfolding sem_classrel_def by blast

lemma sem_arity_alg: "map_of (arities alg a) c = Some Ss \<Longrightarrow> sem_arity a Ss c"
  unfolding sem_arity_def
proof (intro allI impI)
  fix As assume m: "map_of (arities alg a) c = Some Ss" and l: "length As = length Ss"
    and ne: "\<forall>A\<in>set As. une A" and ss: "\<forall>i<length Ss. ssem (Ss ! i) (As ! i)"
  show "cls c (ucon a As)" by (rule cls_arity[OF m l]) (use ne ss in \<open>auto simp: ssem_def\<close>)
qed

lemma sem_arity_classrel: "sem_arity a Ss c \<Longrightarrow> sem_classrel c c' \<Longrightarrow> sem_arity a Ss c'"
  unfolding sem_arity_def sem_classrel_def by (meson une_ucon)

text \<open>Valuations with given values of type variables:\<close>

lemma good_upds:
  assumes d: "distinct vs" and l: "length As = length vs" and ne: "\<forall>A\<in>set As. une A"
    and ss: "\<forall>i<length vs. ssem (snd (vs ! i)) (As ! i)"
  shows "\<exists>\<eta> \<xi>. good \<eta> \<xi> \<and> (\<forall>i<length vs. fst \<eta> (fst (vs ! i)) (snd (vs ! i)) = As ! i)"
proof -
  define f where "f v S = (case map_of (zip vs As) (v, S) of Some A \<Rightarrow> A | None \<Rightarrow> pick_set S)" for v S
  define \<eta> :: "'u tval" where "\<eta> = (f, \<lambda>a S. pick_set S)"
  have fi: "f (fst (vs ! i)) (snd (vs ! i)) = As ! i" if "i < length vs" for i
    using map_of_zip_nth[OF l[symmetric] d, of i] that l by (simp add: f_def)
  have fg: "une (f v S) \<and> (sort_ok alg S \<longrightarrow> sinh S \<longrightarrow> ssem S (f v S))" for v S
  proof (cases "map_of (zip vs As) (v, S)")
    case None
    then show ?thesis using pick_set[of S] by (simp add: f_def)
  next
    case (Some A)
    then have "((v, S), A) \<in> set (zip vs As)" by (rule map_of_SomeD)
    then obtain i where i: "i < length vs" "vs ! i = (v, S)" "As ! i = A"
      using l by (auto simp: in_set_zip)
    with ne ss l have "une A" "ssem S A" by (auto dest: spec[of _ i])
    with Some show ?thesis by (simp add: f_def)
  qed
  have gt: "good_t \<eta>" using fg pick_set by (simp add: good_t_def \<eta>_def)
  define \<xi> :: "'u vval" where "\<xi> = (\<lambda>x T. SOME u. u \<in>\<^sub>u tsem \<eta> T, \<lambda>x T. SOME u. u \<in>\<^sub>u tsem \<eta> T)"
  have "(SOME u. u \<in>\<^sub>u tsem \<eta> T) \<in>\<^sub>u tsem \<eta> T" for T
    using tsem_ne[OF gt, of T] by (auto simp: une_def intro: someI)
  then have "good \<eta> \<xi>" using gt by (simp add: good_def good_v_def \<xi>_def)
  moreover have "\<forall>i<length vs. fst \<eta> (fst (vs ! i)) (snd (vs ! i)) = As ! i" using fi by (simp add: \<eta>_def)
  ultimately show ?thesis by blast
qed

text \<open>
  The class relation of a valid theorem \<open>OFCLASS(?'a::c\<^sub>1, c\<^sub>2)\<close> whose sort hypotheses are sorts
  of its proposition holds in the model:
\<close>

lemma classrel_sound:
  assumes sv: "svalid Sh [] [] (mk_of_class (TVar a [c1]) c2)" and Sh: "Sh \<subseteq> {[c1]}"
    and cc: "class_const (c2 + STR ''_class'') c2" and ty: "e \<turnstile> mk_of_class (TVar a [c1]) c2 : propT"
  shows "sem_classrel c1 c2"
  unfolding sem_classrel_def
proof (intro allI impI)
  fix A assume A: "une A" "cls c1 A"
  then have s: "ssem [c1] A" by (simp add: ssem_def)
  from good_upds[of "[(a, [c1])]" "[A]"] A(1) s obtain \<eta> \<xi> where g: "good \<eta> \<xi>" and e: "fst \<eta> a [c1] = A"
    by auto
  have "holds_at \<eta> \<xi> (mk_of_class (TVar a [c1]) c2)"
    by (rule svalidD[OF sv _ g]) (use Sh A s in \<open>auto simp: sinh_def\<close>)
  then show "cls c2 A" using holds_mk_of_class[OF g cc ty] e by simp
qed

text \<open>The same for the arity of a valid theorem \<open>OFCLASS((?'a\<^sub>1::S\<^sub>1, \<dots>, ?'a\<^sub>n::S\<^sub>n) t, c)\<close>:\<close>

lemma arity_sound:
  assumes sv: "svalid Sh [] [] (mk_of_class (Type t (map (\<lambda>(v, S). TVar v S) vs)) c)"
    and Sh: "Sh \<subseteq> snd ` set vs" and d: "distinct (map fst vs)"
    and cc: "class_const (c + STR ''_class'') c"
    and ty: "e \<turnstile> mk_of_class (Type t (map (\<lambda>(v, S). TVar v S) vs)) c : propT"
  shows "sem_arity t (map snd vs) c"
  unfolding sem_arity_def
proof (intro allI impI)
  fix As assume l: "length As = length (map snd vs)" and ne: "\<forall>A\<in>set As. une A"
    and ss: "\<forall>i<length (map snd vs). ssem (map snd vs ! i) (As ! i)"
  have dv: "distinct vs" using d by (simp add: distinct_map)
  from good_upds[OF dv _ ne, of ] l ss obtain \<eta> \<xi> where g: "good \<eta> \<xi>"
    and e: "\<forall>i<length vs. fst \<eta> (fst (vs ! i)) (snd (vs ! i)) = As ! i"
    by auto
  have "holds_at \<eta> \<xi> (mk_of_class (Type t (map (\<lambda>(v, S). TVar v S) vs)) c)"
  proof (rule svalidD[OF sv _ g])
    fix S assume "S \<in> Sh"
    with Sh obtain i where i: "i < length vs" "S = snd (vs ! i)" by (fastforce simp: in_set_conv_nth)
    with l ne ss have "une (As ! i)" "ssem S (As ! i)" by auto
    then show "sinh S" by (auto simp: sinh_def)
  qed simp_all
  then have "cls c (tsem \<eta> (Type t (map (\<lambda>(v, S). TVar v S) vs)))" using holds_mk_of_class[OF g cc ty] by simp
  moreover have "map (tsem \<eta>) (map (\<lambda>(v, S). TVar v S) vs) = As"
    by (rule nth_equalityI) (use l e in \<open>auto simp: split_beta\<close>)
  ultimately show "cls c (ucon t As)" by simp
qed

text \<open>
  The model is a model of every algebra whose class relations and arities hold in it:
\<close>

lemma model_ext:
  assumes ps: "pure_sig alg' ar"
    and cr: "\<And>c1 c2. class_less alg' c1 c2 \<Longrightarrow> sem_classrel c1 c2"
    and ars: "\<And>a c Ss. map_of (arities alg' a) c = Some Ss \<Longrightarrow> sem_arity a Ss c"
  shows "pure_model alg' ar umem ufun uapp ulam ubool utrue ufalse tcon cls cval"
proof (rule pure_model.intro[OF ps universe_axioms])
  show "pure_model_axioms alg' umem ufun ubool tcon cls cval"
  proof
    show "une (tcon a As)" if "\<And>A. A \<in> set As \<Longrightarrow> une A" for a As using that by (rule tcon_ne)
    show "cls c2 A" if "class_le alg' c1 c2" "une A" "cls c1 A" for c1 c2 A
      using that cr by (auto simp: class_le_def sem_classrel_def)
    show "cls c (tycon ufun ubool tcon a As)"
      if "map_of (arities alg' a) c = Some Ss" "length As = length Ss" "\<And>A. A \<in> set As \<Longrightarrow> une A"
        "\<And>i c'. i < length Ss \<Longrightarrow> c' \<in> set (Ss ! i) \<Longrightarrow> cls c' (As ! i)" for a c Ss As
      using ars[OF that(1)] that(2-) by (auto simp: sem_arity_def ssem_def)
    show "cval c A \<in>\<^sub>u A" if "une A" for c A using that by (rule cval_mem)
  qed
qed

end


subsection \<open>The extended algebras\<close>

text \<open>
  What \<open>Sorts.add_classrel\<close> makes of an algebra: the same classes, the class relation generated
  by the old one and the new pair, and arities that follow from old ones by a class relation
  (\<open>rebuild_arities\<close>). The old arities are kept or replaced by more general ones
  (\<^const>\<open>alg_le\<close>).
\<close>

definition classrel_ext :: "algebra \<Rightarrow> algebra \<Rightarrow> pclass \<Rightarrow> pclass \<Rightarrow> bool" where
  "classrel_ext alg alg' c1 c2 \<longleftrightarrow> alg_le alg alg' \<and> classes alg' = classes alg \<and>
    (\<forall>x y. class_less alg' x y \<longrightarrow> (\<lambda>x y. class_less alg x y \<or> (x = c1 \<and> y = c2))\<^sup>+\<^sup>+ x y) \<and>
    (\<forall>a c Ss. map_of (arities alg' a) c = Some Ss \<longrightarrow>
      (\<exists>c0. map_of (arities alg a) c0 = Some Ss \<and> class_le alg' c0 c))"

text \<open>
  What \<open>Sorts.add_arities\<close> makes of it for one arity: the same classes and class relation, and
  arities that are old ones or follow from the new one by a class relation (\<open>complete\<close>).
\<close>

definition arity_ext :: "algebra \<Rightarrow> algebra \<Rightarrow> name \<Rightarrow> psort list \<Rightarrow> pclass \<Rightarrow> bool" where
  "arity_ext alg alg' t Ss c \<longleftrightarrow> alg_le alg alg' \<and> classes alg' = classes alg \<and>
    class_less alg' = class_less alg \<and>
    (\<forall>a c' Ss'. map_of (arities alg' a) c' = Some Ss' \<longrightarrow>
      map_of (arities alg a) c' = Some Ss' \<or> (a = t \<and> Ss' = Ss \<and> class_le alg c c'))"

text \<open>
  The signature with another algebra is an extension if the algebra is one, the axioms of the
  signature are well-typed propositions, and the atoms of its proofs mention declared constants.
\<close>

lemma sign_le_alg:
  assumes ps: "pure_sig (sg_alg c) (sg_ar c)" and le: "alg_le (sg_alg c) alg'"
    and cl: "classes alg' = classes (sg_alg c)"
    and ax: "\<And>a A. sg_axioms c a = Some A \<Longrightarrow> pure_sig.wtp (sg_alg c) (sg_ar c) (sg_consts c) A"
    and at: "\<And>A n. sg_ax c A \<Longrightarrow> n \<in> term_consts A \<Longrightarrow> const_decl (sg_consts c) n"
  shows "sign_le c (c\<lparr>sg_alg := alg'\<rparr>)"
  using assms by (auto simp: sign_le_def)


subsection \<open>The models of the extended signature\<close>

text \<open>
  A model of a signature is a model of the signature with an algebra of the same classes whose
  class relations and arities hold in it.
\<close>

lemma is_model_alg:
  fixes M :: "'u model"
  assumes m: "is_model c M" and sl: "sign_le c (c\<lparr>sg_alg := alg'\<rparr>)" and ps': "pure_sig alg' (sg_ar c)"
    and cr: "\<And>c1 c2. class_less alg' c1 c2 \<Longrightarrow>
      pure_model.sem_classrel (m_mem M) (m_cls M) c1 c2"
    and ars: "\<And>a c' Ss. map_of (arities alg' a) c' = Some Ss \<Longrightarrow>
      pure_model.sem_arity (m_mem M) (m_fun M) (m_bool M) (m_tcon M) (m_cls M) a Ss c'"
  shows "is_model (c\<lparr>sg_alg := alg'\<rparr>) M"
proof -
  let ?c' = "c\<lparr>sg_alg := alg'\<rparr>"
  interpret M: pure_model "sg_alg c" "sg_ar c" "sg_consts c" "m_mem M" "m_fun M" "m_app M" "m_lam M"
    "m_bool M" "m_true M" "m_false M" "m_tcon M" "m_cls M" "m_cval M"
    by (rule is_modelD[OF m])
  have pm': "pure_model alg' (sg_ar c) (m_mem M) (m_fun M) (m_app M) (m_lam M) (m_bool M) (m_true M)
      (m_false M) (m_tcon M) (m_cls M) (m_cval M)"
    by (rule M.model_ext[OF ps']) (use cr ars in auto)
  interpret V: sem_ext "sg_alg c" alg' "sg_ar c" "sg_consts c" "sg_consts c"
    "m_mem M" "m_fun M" "m_app M" "m_lam M" "m_bool M" "m_true M" "m_false M" "m_tcon M" "m_cls M" "m_cval M"
    using pm' sig_ext_sign_le[OF sl] ps' unfolding sem_ext_def by simp
  have "valid_in ?c' M (tm_sorts A) [] [] A" if a: "sg_axioms ?c' a = Some A" for a A
  proof -
    from a have a0: "sg_axioms c a = Some A" by simp
    with sl have w: "M.wtp A" by (auto simp: sign_le_def)
    have "M.wf_terms [] [] A" using w by (simp add: M.wf_terms_def M.wtp_def M.gterm_def)
    with is_model_axiom[OF m a0] V.valid_ext show ?thesis by (simp add: valid_in_def)
  qed
  with pm' show ?thesis by (simp add: is_model_def)
qed

text \<open>
  \<open>Thm.add_classrel\<close>: the theorem \<open>th\<close> states the class relation; its data satisfy the invariant
  of theorems (as the data of every derivable theorem do, \<open>derivable_sound\<close>), and it passes
  \<open>Thm.plain_prop_of\<close>. The class \<open>c\<^sub>2\<close> is declared with its constant.
\<close>

theorem add_classrel_model:
  fixes M :: "'u model"
  assumes m: "is_model c M" and d: "dok TYPE('u) th" and sg: "th_sign th = c"
    and plain: "th_hyps th = []" "th_tpairs th = []" "th_shyps th \<subseteq> tm_sorts (th_prop th)"
    and pr: "th_prop th = mk_of_class (TVar a [c1]) c2"
    and cc: "pure_sig.class_const (sg_alg c) (sg_consts c) (c2 + STR ''_class'') c2"
    and ext: "classrel_ext (sg_alg c) alg' c1 c2" and ps': "pure_sig alg' (sg_ar c)"
    and ax: "\<And>a A. sg_axioms c a = Some A \<Longrightarrow> pure_sig.wtp (sg_alg c) (sg_ar c) (sg_consts c) A"
    and at: "\<And>A n. sg_ax c A \<Longrightarrow> n \<in> term_consts A \<Longrightarrow> const_decl (sg_consts c) n"
  shows "is_model (c\<lparr>sg_alg := alg'\<rparr>) M" and "sign_le c (c\<lparr>sg_alg := alg'\<rparr>)"
proof -
  interpret M: pure_model "sg_alg c" "sg_ar c" "sg_consts c" "m_mem M" "m_fun M" "m_app M" "m_lam M"
    "m_bool M" "m_true M" "m_false M" "m_tcon M" "m_cls M" "m_cval M"
    by (rule is_modelD[OF m])
  have ps: "pure_sig (sg_alg c) (sg_ar c)" by (rule M.pure_sig_axioms)
  from ext have le: "alg_le (sg_alg c) alg'" and cl: "classes alg' = classes (sg_alg c)"
    by (simp_all add: classrel_ext_def)
  show sl: "sign_le c (c\<lparr>sg_alg := alg'\<rparr>)" by (rule sign_le_alg[OF ps le cl ax at])
  let ?P = "mk_of_class (TVar a [c1]) c2"
  from d ps sg have wf: "M.thm_wf (th_maxidx th) [] [] ?P"
    by (simp add: dok_def thm_ok_def plain pr)
  then have wP: "M.wtp ?P" by (simp add: M.thm_wf_def M.wt_thm_def)
  have wt: "M.wf_terms [] [] ?P" using wP by (simp add: M.wf_terms_def M.wtp_def M.gterm_def)
  have "M.valid (th_shyps th) [] [] ?P" using dok_valid[OF d] m sg plain pr by (simp add: valid_in_def)
  then have sv: "M.svalid (th_shyps th) [] [] ?P" using M.valid_svalid[OF wt] by simp
  have c12: "M.sem_classrel c1 c2"
    by (rule M.classrel_sound[OF sv _ cc M.wtpD(2)[OF wP]]) (use plain(3) pr in simp)
  have cr: "M.sem_classrel x y" if "class_less alg' x y" for x y
  proof -
    from ext that have "(\<lambda>x y. class_less (sg_alg c) x y \<or> (x = c1 \<and> y = c2))\<^sup>+\<^sup>+ x y"
      by (simp add: classrel_ext_def)
    then show ?thesis
    proof (induction rule: tranclp_induct)
      case (base y)
      then show ?case using c12 M.sem_classrel_le by (auto simp: class_le_def)
    next
      case (step y z)
      from step(2) have "M.sem_classrel y z" using c12 M.sem_classrel_le by (auto simp: class_le_def)
      with step(3) show ?case by (rule M.sem_classrel_trans)
    qed
  qed
  have ars: "M.sem_arity t Ss c'" if "map_of (arities alg' t) c' = Some Ss" for t c' Ss
  proof -
    from ext that obtain c0 where c0: "map_of (arities (sg_alg c) t) c0 = Some Ss" "class_le alg' c0 c'"
      unfolding classrel_ext_def by blast
    have "M.sem_classrel c0 c'" using c0(2) cr by (auto simp: class_le_def M.sem_classrel_def)
    with M.sem_arity_alg[OF c0(1)] show ?thesis by (rule M.sem_arity_classrel)
  qed
  show "is_model (c\<lparr>sg_alg := alg'\<rparr>) M" by (rule is_model_alg[OF m sl ps' cr ars])
qed

text \<open>\<open>Thm.add_arity\<close>, in the same way; the type variables of the proposition are distinct.\<close>

theorem add_arity_model:
  fixes M :: "'u model"
  assumes m: "is_model c M" and d: "dok TYPE('u) th" and sg: "th_sign th = c"
    and plain: "th_hyps th = []" "th_tpairs th = []" "th_shyps th \<subseteq> tm_sorts (th_prop th)"
    and pr: "th_prop th = mk_of_class (Type t (map (\<lambda>(v, S). TVar v S) vs)) cl"
    and dv: "distinct (map fst vs)"
    and cc: "pure_sig.class_const (sg_alg c) (sg_consts c) (cl + STR ''_class'') cl"
    and ext: "arity_ext (sg_alg c) alg' t (map snd vs) cl" and ps': "pure_sig alg' (sg_ar c)"
    and ax: "\<And>a A. sg_axioms c a = Some A \<Longrightarrow> pure_sig.wtp (sg_alg c) (sg_ar c) (sg_consts c) A"
    and at: "\<And>A n. sg_ax c A \<Longrightarrow> n \<in> term_consts A \<Longrightarrow> const_decl (sg_consts c) n"
  shows "is_model (c\<lparr>sg_alg := alg'\<rparr>) M" and "sign_le c (c\<lparr>sg_alg := alg'\<rparr>)"
proof -
  interpret M: pure_model "sg_alg c" "sg_ar c" "sg_consts c" "m_mem M" "m_fun M" "m_app M" "m_lam M"
    "m_bool M" "m_true M" "m_false M" "m_tcon M" "m_cls M" "m_cval M"
    by (rule is_modelD[OF m])
  have ps: "pure_sig (sg_alg c) (sg_ar c)" by (rule M.pure_sig_axioms)
  from ext have le: "alg_le (sg_alg c) alg'" and cl: "classes alg' = classes (sg_alg c)"
    and less: "class_less alg' = class_less (sg_alg c)"
    by (simp_all add: arity_ext_def)
  show sl: "sign_le c (c\<lparr>sg_alg := alg'\<rparr>)" by (rule sign_le_alg[OF ps le cl ax at])
  let ?P = "mk_of_class (Type t (map (\<lambda>(v, S). TVar v S) vs)) cl"
  from d ps sg have wf: "M.thm_wf (th_maxidx th) [] [] ?P"
    by (simp add: dok_def thm_ok_def plain pr)
  then have wP: "M.wtp ?P" by (simp add: M.thm_wf_def M.wt_thm_def)
  have wt: "M.wf_terms [] [] ?P" using wP by (simp add: M.wf_terms_def M.wtp_def M.gterm_def)
  have "M.valid (th_shyps th) [] [] ?P" using dok_valid[OF d] m sg plain pr by (simp add: valid_in_def)
  then have sv: "M.svalid (th_shyps th) [] [] ?P" using M.valid_svalid[OF wt] by simp
  have new: "M.sem_arity t (map snd vs) cl"
    by (rule M.arity_sound[OF sv _ dv cc M.wtpD(2)[OF wP]]) (use plain(3) pr in \<open>auto simp: split_beta\<close>)
  have cr: "M.sem_classrel x y" if "class_less alg' x y" for x y
    using that less by (auto intro: M.sem_classrel_le simp: class_le_def)
  have ars: "M.sem_arity a Ss c'" if "map_of (arities alg' a) c' = Some Ss" for a c' Ss
  proof -
    from ext that consider "map_of (arities (sg_alg c) a) c' = Some Ss"
      | "a = t" "Ss = map snd vs" "class_le (sg_alg c) cl c'"
      unfolding arity_ext_def by blast
    then show ?thesis
    proof cases
      case 1
      then show ?thesis by (rule M.sem_arity_alg)
    next
      case 2
      from new M.sem_classrel_le[OF 2(3)] show ?thesis unfolding 2(1,2) by (rule M.sem_arity_classrel)
    qed
  qed
  show "is_model (c\<lparr>sg_alg := alg'\<rparr>) M" by (rule is_model_alg[OF m sl ps' cr ars])
qed

subsection \<open>Constants\<close>

text \<open>
  A model interprets every name of a constant. So it is a model of an extension of the
  signature that declares more constants and has the same algebra and axioms.
\<close>

lemma is_model_consts:
  fixes M :: "'u model"
  assumes m: "is_model c M" and sl: "sign_le c c'" and alg: "sg_alg c' = sg_alg c"
    and axs: "sg_axioms c' = sg_axioms c"
  shows "is_model c' M"
proof -
  interpret M: pure_model "sg_alg c" "sg_ar c" "sg_consts c" "m_mem M" "m_fun M" "m_app M" "m_lam M"
    "m_bool M" "m_true M" "m_false M" "m_tcon M" "m_cls M" "m_cval M"
    by (rule is_modelD[OF m])
  have ar: "sg_ar c' = sg_ar c" using sl by (simp add: sign_le_def)
  have pm': "pure_model (sg_alg c') (sg_ar c') (m_mem M) (m_fun M) (m_app M) (m_lam M) (m_bool M) (m_true M)
      (m_false M) (m_tcon M) (m_cls M) (m_cval M)"
    using is_modelD[OF m] alg ar by simp
  have ps': "pure_sig (sg_alg c') (sg_ar c')" using M.pure_sig_axioms alg ar by simp
  interpret V: sem_ext "sg_alg c" "sg_alg c'" "sg_ar c" "sg_consts c" "sg_consts c'"
    "m_mem M" "m_fun M" "m_app M" "m_lam M" "m_bool M" "m_true M" "m_false M" "m_tcon M" "m_cls M" "m_cval M"
    using pm' sig_ext_sign_le[OF sl ps'] ar unfolding sem_ext_def by simp
  have "valid_in c' M (tm_sorts A) [] [] A" if a: "sg_axioms c' a = Some A" for a A
  proof -
    from a axs have a0: "sg_axioms c a = Some A" by simp
    with sl have w: "M.wtp A" by (auto simp: sign_le_def)
    have "M.wf_terms [] [] A" using w by (simp add: M.wf_terms_def M.wtp_def M.gterm_def)
    with is_model_axiom[OF m a0] V.valid_ext ar show ?thesis by (simp add: valid_in_def)
  qed
  with pm' show ?thesis by (simp add: is_model_def)
qed


subsection \<open>Theories with the models of a given theory\<close>

text \<open>
  The signatures that are reached from a signature \<open>c\<^sub>0\<close> by declarations of constants and by
  class relations and arities that derivable theorems state:
\<close>

inductive extends_by :: "sign \<Rightarrow> sign \<Rightarrow> bool" for c0 :: sign where
  base: "extends_by c0 c0"
| decl: "extends_by c0 c \<Longrightarrow> sign_le c c' \<Longrightarrow> sg_alg c' = sg_alg c \<Longrightarrow> sg_axioms c' = sg_axioms c \<Longrightarrow>
    extends_by c0 c'"
| classrel: "extends_by c0 c \<Longrightarrow> derivable th \<Longrightarrow> th_sign th = c \<Longrightarrow> th_hyps th = [] \<Longrightarrow> th_tpairs th = [] \<Longrightarrow>
    th_shyps th \<subseteq> tm_sorts (th_prop th) \<Longrightarrow> th_prop th = mk_of_class (TVar a [c1]) c2 \<Longrightarrow>
    pure_sig.class_const (sg_alg c) (sg_consts c) (c2 + STR ''_class'') c2 \<Longrightarrow>
    classrel_ext (sg_alg c) alg' c1 c2 \<Longrightarrow> pure_sig alg' (sg_ar c) \<Longrightarrow>
    \<forall>a A. sg_axioms c a = Some A \<longrightarrow> pure_sig.wtp (sg_alg c) (sg_ar c) (sg_consts c) A \<Longrightarrow>
    \<forall>A n. sg_ax c A \<longrightarrow> n \<in> term_consts A \<longrightarrow> const_decl (sg_consts c) n \<Longrightarrow>
    extends_by c0 (c\<lparr>sg_alg := alg'\<rparr>)"
| arity: "extends_by c0 c \<Longrightarrow> derivable th \<Longrightarrow> th_sign th = c \<Longrightarrow> th_hyps th = [] \<Longrightarrow> th_tpairs th = [] \<Longrightarrow>
    th_shyps th \<subseteq> tm_sorts (th_prop th) \<Longrightarrow>
    th_prop th = mk_of_class (Type t (map (\<lambda>(v, S). TVar v S) vs)) cl \<Longrightarrow> distinct (map fst vs) \<Longrightarrow>
    pure_sig.class_const (sg_alg c) (sg_consts c) (cl + STR ''_class'') cl \<Longrightarrow>
    arity_ext (sg_alg c) alg' t (map snd vs) cl \<Longrightarrow> pure_sig alg' (sg_ar c) \<Longrightarrow>
    \<forall>a A. sg_axioms c a = Some A \<longrightarrow> pure_sig.wtp (sg_alg c) (sg_ar c) (sg_consts c) A \<Longrightarrow>
    \<forall>A n. sg_ax c A \<longrightarrow> n \<in> term_consts A \<longrightarrow> const_decl (sg_consts c) n \<Longrightarrow>
    extends_by c0 (c\<lparr>sg_alg := alg'\<rparr>)"

text \<open>They have the models of \<open>c\<^sub>0\<close>:\<close>

theorem extends_by_model:
  fixes M :: "'u model"
  assumes "extends_by c0 c" "is_model c0 M"
  shows "is_model c M"
  using assms
proof (induction rule: extends_by.induct)
  case base
  then show ?case .
next
  case (decl c c')
  show ?case by (rule is_model_consts[OF decl.IH[OF decl.prems] decl.hyps(2,3,4)])
next
  case (classrel c th a c1 c2 alg')
  note h = classrel.hyps
  show ?case
    by (rule add_classrel_model(1)[OF classrel.IH[OF classrel.prems] derivable_sound[OF h(2)] h(3-10)])
      (use h(11,12) in blast)+
next
  case (arity c th t vs cl alg')
  note h = arity.hyps
  show ?case
    by (rule add_arity_model(1)[OF arity.IH[OF arity.prems] derivable_sound[OF h(2)] h(3-11)])
      (use h(12,13) in blast)+
qed

text \<open>
  So the derivable theorems of these theories are valid in each model of \<open>c\<^sub>0\<close>, and none of them
  without hypotheses and flex-flex pairs, whose sort hypotheses are inhabited in the model, is
  \<open>\<And>P. P\<close>:
\<close>

corollary extends_by_valid:
  fixes M :: "'u model"
  assumes "extends_by c0 (th_sign th)" "is_model c0 M" "derivable th"
  shows "valid_in (th_sign th) M (th_shyps th) (th_hyps th) (th_tpairs th) (th_prop th)"
  by (rule derivable_valid[OF assms(3) extends_by_model[OF assms(1,2)]])

corollary extends_by_consistent:
  fixes M :: "'u model"
  assumes "extends_by c0 (th_sign th)" "is_model c0 M" "derivable th"
    and "th_hyps th = []" "th_tpairs th = []" "\<forall>S\<in>th_shyps th. m_sinh M S"
  shows "th_prop th \<noteq> all_const propT $ Abs x propT (Bound 0)"
  by (rule derivable_consistent[OF assms(3) extends_by_model[OF assms(1,2)] assms(4-6)])


end
