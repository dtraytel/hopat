#!/usr/bin/env bash
#
# Assemble a replacement for $ISABELLE_HOME/src/Pure/unify.ML from the code generated
# in session Pure_Unify (theory Pure_Unify_Code) and unify_wrapper.ML.
#
# Usage: make_unify_ML [OUTPUT]   (default: generated/unify.ML)

set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
OUT="${1:-$DIR/generated/unify.ML}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

mkdir -p "$(dirname "$OUT")"
isabelle build -d "$DIR/.." -e Pure_Unify
isabelle export -d "$DIR/.." -O "$TMP" -x "Pure_Unify.Pure_Unify_Code:code/**" Pure_Unify

{
  cat <<'HEADER'
(*  Title:      Pure/unify.ML
    Author:     Generated from the Isabelle/HOL formalization in session Pure_Unify
                (theories Unify_Base, Pure_Unify, Pure_Unify_Code), following the
                original by Lawrence C Paulson, Cambridge University Computer Laboratory.

Higher-Order Unification.

Types as well as terms are unified.  The outermost functions assume
the terms to be unified already have the same type.  In resolution,
this is assured because both have type "prop".

Deviations from the original, which loses unifiers there:
(1) In flex-flex pairs, an argument with a rigid banned bound variable
is deleted (clean_term) only if all arguments have rigid heads, and the
arguments of a beta-redex are not rigid (rigid_bound).  The original
misses ?F := %x. x (%w. c), ?G := c for %j. ?F (%z. z j) =?= %j. ?G.
(2) In the rigid occurs check (rigid_occurs_term), an occurrence of the
variable applied to arguments is rigid only if all arguments are bound
variables, as in Pattern.unify.  The original finds no unifier for
%y. ?v y =?= %y. y (?v (%z. d)), which has the unifier ?v := %y. y d.
(3) In MATCH, if the variable v occurs in u, in its arguments or in the
other pairs, only a single step is taken (match1): the projections and
the imitation with new variables for the arguments, keeping the pair.
Copying u may assign the new variables of a projection to terms that
contain v, and the update of v then closes a cycle in the environment,
on which normalization diverges: for %x. ?v x =?= %x. x (c (?F ?v)),
the projection ?v := %x. x (?G x) assigns ?G := %x. c (?F ?v).

DO NOT EDIT: generated by make_unify_ML.
*)

signature UNIFY =
sig
  val search_bound: int Config.T
  val unify_trace: bool Config.T
  val unify_trace_bound: int Config.T
  val unify_trace_simp: bool Config.T
  val unify_trace_types: bool Config.T
  val hounifiers: (string * typ) list -> Context.generic * Envir.env * ((term * term) list) ->
    (Envir.env * (term * term) list) Seq.seq
  val unifiers: Context.generic * Envir.env * ((term * term) list) ->
    (Envir.env * (term * term) list) Seq.seq
  val smash_unifiers: Context.generic -> (term * term) list -> Envir.env -> Envir.env Seq.seq
end;


(** generated code **)

HEADER
  cat "$TMP/Pure_Unify.Pure_Unify_Code/code/unify_generated.ML"
  printf '\n\n(** wrapper **)\n\n'
  sed -n '/^signature UNIFY_GENERATED/,$p' "$DIR/unify_wrapper.ML"
  cat <<'FOOTER'

structure Unify: UNIFY =
  Unify_Fun(
    val search_bound = Config.declare_int ("unify_search_bound", \<^here>) (K 60)
    val unify_trace = Config.declare_bool ("unify_trace", \<^here>) (K false)
    val unify_trace_bound = Config.declare_int ("unify_trace_bound", \<^here>) (K 50)
    val unify_trace_simp = Config.declare_bool ("unify_trace_simp", \<^here>) (K false)
    val unify_trace_types = Config.declare_bool ("unify_trace_types", \<^here>) (K false));
FOOTER
} > "$OUT"

echo "Generated $OUT"
