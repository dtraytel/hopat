#!/usr/bin/env bash
#
# Generate the reference for the differential test (theory Pure_Unify_Test): the unify.ML of
# the Isabelle2026 release with the unify patches of ../../patches applied, as structure
# Unify_Reference, sharing the configuration options of Unify.
#
# Usage: make_unify_reference [ISABELLE_HOME]   (default: isabelle getenv -b ISABELLE_HOME)

set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
HOME_DIR="${1:-$(isabelle getenv -b ISABELLE_HOME)}"
OUT="$DIR/unify_reference.ML"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

mkdir -p "$TMP/src/Pure"
cp "$HOME_DIR/src/Pure/unify.ML" "$TMP/src/Pure/unify.ML"
for P in "$DIR"/../../patches/[0-9][0-9]-unify-*.patch; do
  (cd "$TMP" && patch -p1 -s --no-backup-if-mismatch < "$P")
done

{
  cat <<'HEADER'
(*Reference for the differential test of session Pure_Unify (theory Pure_Unify_Test):
  src/Pure/unify.ML of the Isabelle2026 release with patches/??-unify-*.patch applied,
  as structure Unify_Reference; the configuration options are those of Unify.

  DO NOT EDIT: generated by make_unify_reference.*)

HEADER
  sed -e 's/^signature UNIFY =$/signature UNIFY_REFERENCE =/' \
    -e 's/^structure Unify : UNIFY =$/structure Unify_Reference : UNIFY_REFERENCE =/' \
    -e 's/^val \([a-z_]*\) = Config\.declare_[a-z]* (.*$/val \1 = Unify.\1;/' \
    "$TMP/src/Pure/unify.ML"
} > "$OUT"

echo "Generated $OUT"
