chapter Pattern_Unification

session Nipkow_Grobauer_Pattern in Nipkow_Grobauer_Pattern = HOL +
  description \<open>
    Higher-order pattern unification (Nipkow's algorithm) on de Bruijn
    lambda-terms: termination and correctness (most general unifiers for
    well-typed patterns), following Grobauer's pen-and-paper proofs.
  \<close>
  sessions
    "HOL-Library"
    "HOL-Proofs-Lambda"
  theories
    Unif_Termination
    Unif_Correctness
  document_files
    "root.bib"
    "root.tex"

session HOPAT_Substitution in Substitution = HOL +
  description \<open>
    The substitution lemma in three styles (de Bruijn, Nominal, Nominal2) for
    comparison, and a partial termination proof.
  \<close>
  sessions
    "HOL-Nominal"
    Nominal2
  theories
    Partial_Termination
    DeBruijn_Substitution_Lemma
    Nominal_Substitution_Lemma
    Nominal2_Substitution_Lemma

session Pure_Pattern in Pure_Pattern = HOL +
  description \<open>
    A faithful formalization of Isabelle/Pure's pattern unification and matching
    (src/Pure/pattern.ML, including sorts, Type.unify and Envir), from which a
    drop-in replacement for pattern.ML is generated.
  \<close>
  sessions
    "HOL-Library"
  theories
    Pure_Pattern_Code
    Pure_Pattern_Test

session Pure_Pattern_Correctness in Pure_Pattern_Correctness = Nipkow_Grobauer_Pattern +
  description \<open>
    Correctness of the formalization of Isabelle/Pure's pattern unification
    (session Pure_Pattern), via a translation into the de Bruijn terms of
    session Nipkow_Grobauer_Pattern.
  \<close>
  sessions
    Pure_Pattern
  theories
    Pattern_Unif_Complete
