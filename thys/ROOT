chapter Pattern_Unification

session Nipkow_Grobauer_Pattern in Nipkow_Grobauer_Pattern = HOL +
  description \<open>
    Higher-order pattern unification (Nipkow's algorithm) on de Bruijn
    lambda-terms: termination and correctness (most general unifiers for
    well-typed patterns), following Grobauer's pen-and-paper proofs.
  \<close>
  sessions
    "HOL-Library"
    "HOL-Proofs-Lambda"
  theories
    Unif_Termination
    Unif_Correctness
  document_files
    "root.bib"
    "root.tex"

session Pure_Pattern in Pure_Pattern = HOL +
  description \<open>
    A faithful formalization of Isabelle/Pure's pattern unification and matching
    (src/Pure/pattern.ML, including sorts, Type.unify and Envir), with a fix of the
    occurs check, from which a drop-in replacement for pattern.ML is generated.
  \<close>
  sessions
    "HOL-Library"
  theories
    Pure_Pattern_Code
    Pure_Pattern_Test

session Pure_Pattern_Correctness in Pure_Pattern_Correctness = Nipkow_Grobauer_Pattern +
  description \<open>
    Correctness and termination of the formalization of Isabelle/Pure's pattern unification
    (session Pure_Pattern), via a translation into the de Bruijn terms of
    session Nipkow_Grobauer_Pattern, for problems with schematic type variables and sorts.
  \<close>
  sessions
    Pure_Pattern
  theories
    Pattern_Correctness
    Pattern_Example
    Match_Correctness

session Pure_Unify in Pure_Unify = Pure_Pattern +
  description \<open>
    A faithful formalization of Isabelle/Pure's higher-order unification
    (src/Pure/unify.ML), from which a drop-in replacement for unify.ML is generated.
  \<close>
  theories
    Pure_Unify_Code
    Pure_Unify_Test

session Pure_Thm in Pure_Thm = Pure_Pattern +
  description \<open>
    A faithful formalization of the composition of theorems in Isabelle/Pure (bicompose_aux
    of src/Pure/thm.ML, the inference behind resolution), from which a replacement of
    bicompose_aux in thm.ML is generated.
  \<close>
  sessions
    Pure_Unify
  theories
    Pure_Bicompose_Code
    Pure_Bicompose_Test
    Pure_Proofterm_Test

session Pure_Unify_Correctness in Pure_Unify_Correctness = Pure_Pattern_Correctness +
  description \<open>
    Soundness and completeness of the formalization of Isabelle/Pure's higher-order
    unification (session Pure_Unify), via the translation into de Bruijn terms of
    session Nipkow_Grobauer_Pattern used for Pure_Pattern_Correctness.
  \<close>
  sessions
    Pure_Unify
  theories
    Unify_Correctness
    Unify_Simpl_Complete
    Unify_Dfs
    Unify_Match_Complete
    Unify_Flexflex_Complete
    Unify_Complete
    Unify_Unifiers
    Unify_Simpl_Term
    Unify_Fin
    Unify_Dead
    Unify_Match_Fin
    Unify_Smash
    Unify_Poly_Pull
    Unify_Poly_Match_Complete
    Unify_Poly_Flexflex_Complete
    Unify_Poly_Complete
    Unify_Poly_Simpl_Term
    Unify_Poly_Fin
    Unify_Poly_Match_Fin
    Unify_Poly_Unifiers
    Unify_Poly_Smash

session Pure_Thm_Correctness in Pure_Thm_Correctness = Pure_Unify_Correctness +
  description \<open>
    Soundness, completeness and termination of the formalization of bicompose_aux and
    biresolution of Isabelle/Pure's thm.ML (session Pure_Thm), in the semantics of session
    Pure_Unify_Correctness; the results of biresolution are well-typed again, so that
    biresolution is an operation on an abstract type of theorems.
  \<close>
  sessions
    Pure_Thm
  theories
    Bicompose_Correct
    Bicompose_Fin
    Bicompose_Complete
    Biresolution_Correct
    Thm_Type
    Proof_Subst
    Proof_Judgment
    Proof_Inst
    Proof_Valid
    Proof_Freeze

session Unpatched_Examples in Unpatched_Examples = HOL +
  description \<open>
    What the fixes of unify.ML and pattern.ML prevent, shown in Isabelle2026 without the patches:
    proofs of False from a cyclic environment and from an unsaturated flex-rigid pair,
    ill-typed proof states, and lost unifiers.
  \<close>
  theories
    Unpatched_Examples
