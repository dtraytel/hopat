#!/usr/bin/env bash
#
# Assemble a replacement for $ISABELLE_HOME/src/Pure/thm.ML in which the functions lift_rule,
# bicompose_aux (with its auxiliary functions) and biresolution are replaced by the code
# generated in session Pure_Thm (theory Pure_Bicompose_Code) and bicompose_wrapper.ML.
#
# Usage: make_thm_ML [OUTPUT [ORIGINAL]]
#   (default: generated/thm.ML from $ISABELLE_HOME/src/Pure/thm.ML)

set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
OUT="${1:-$DIR/generated/thm.ML}"
ORIG="${2:-$(isabelle getenv -b ISABELLE_HOME)/src/Pure/thm.ML}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

mkdir -p "$(dirname "$OUT")"
isabelle build -d "$DIR/.." -e Pure_Thm
isabelle export -d "$DIR/.." -O "$TMP" -x "Pure_Thm.Pure_Bicompose_Code:code/**" Pure_Thm
GEN="$TMP/Pure_Thm.Pure_Bicompose_Code/code/bicompose_generated.ML"

line() {
  local n
  n="$(grep -n -m 1 -e "$1" "$ORIG" | cut -d: -f1)"
  if [ -z "$n" ]; then echo "make_thm_ML: cannot find \"$1\" in $ORIG" >&2; exit 2; fi
  echo "$n"
}

STRUCT="$(line '^structure Thm: THM =')"
LIFT="$(line '^(\*Prepare orule for resolution by lifting it')"
INCR="$(line '^fun incr_indexes i ')"
FIRST="$(line '^(\* strip_apply f B A strips off')"
NEXT="$(line '^fun bicompose opt_ctxt flags arg i state =')"
QUICK="$(line '^(\*Quick test whether rule is resolvable')"
RSN="$(line '^(\*Resolution: exactly one resolvent')"

{
  head -n "$((STRUCT - 1))" "$ORIG"
  cat <<'HEADER'
(** lift_rule, bicompose_aux, biresolution: generated code **)

(*Generated from the Isabelle/HOL formalization in session Pure_Thm (theories
  Pure_Bicompose, Pure_Biresolution, Pure_Bicompose_Code), on top of the formalization of
  Pure's terms, environments and type unification in session Pure_Pattern and of unify.ML in
  session Pure_Unify.  The functions lift_rule, bicompose_aux and biresolution of structure Thm
  below are the wrappers of bicompose_wrapper.ML around this code.

  DO NOT EDIT: generated by make_thm_ML.*)

HEADER
  cat "$GEN"
  printf '\n\n'
  sed -n "${STRUCT},$((LIFT - 1))p" "$ORIG"
  sed -n '/^(\*Prepare orule for resolution by lifting it/,/^(\*\*\* RESOLUTION \*\*\*)/p' \
    "$DIR/bicompose_wrapper.ML" | sed '$d'
  printf '\n'
  sed -n "${INCR},$((FIRST - 1))p" "$ORIG"
  printf '(*** RESOLUTION ***)\n\n'
  sed -n '/^(\*Composition of object rule/,$p' "$DIR/bicompose_wrapper.ML"
  printf '\n'
  sed -n "${NEXT},$((QUICK - 1))p" "$ORIG"
  sed -n "${RSN},\$p" "$ORIG"
} > "$OUT"

echo "Generated $OUT"
