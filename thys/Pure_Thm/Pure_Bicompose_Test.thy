section \<open>Testing the Generated Code against \<open>Thm.bicompose_aux\<close>\<close>

theory Pure_Bicompose_Test
  imports Pure_Bicompose_Code
begin

text \<open>
  The generated code is compiled into the running ML environment. Outside of \<open>thm.ML\<close>, the
  type \<open>thm\<close> is abstract, so the test version of the wrapper returns the logical content of
  the new theorems: their propositions, flex-flex pairs and maximal indices. They are compared
  with the theorems of Pure's \<open>Thm.biresolution\<close> and \<open>Thm.bicompose\<close>, which are
  \<open>bicompose_aux\<close> with lifting and without, on problems taken from the theorems of HOL. The
  first results of both must agree exactly, including the names of bound variables and the
  exceptions raised. The drop-in replacement of \<open>thm.ML\<close> generated by \<open>make_thm_ML\<close>
  contains the same code, with the wrapper of \<^file>\<open>bicompose_wrapper.ML\<close>.
\<close>

code_reflect Bicompose_Generated
  datatypes tres = TOk | TErr
    and texn = UExn | THM | ERROR | COMPOSE
    and thm_args = Orule | Orule_State
    and uexn = PExn | CANTUNIFY | ASSIGN | CHANGE_FAIL | Bind
    and exn = Unif | Pattern | Match | TUnify | Type_Match | Class_Error | Type_Error | Term_Error
      | Failure | Subscript | Unequal_Lengths | Dup
    and unif_trace = No_Trace | Typ_Clash | Clash | Clash_BB | Clash_B | Proj_Fail | Ocheck_Fail
    and class_error = No_Classrel | No_Arity | No_Subsort
    and event = Ev_Unif | Ev_Loss | Ev_Dpairs | Ev_Failure_Node | Ev_Bound_Exceeded
    and bops = BOps
    and bres = BRes
    and newas = NewAs
  functions bicompose_aux bpull ren_term

ML \<open>
structure Bicompose_Test =
struct

structure G = Bicompose_Generated;

(* the wrapper of bicompose_wrapper.ML, without the construction of theorems *)

fun typ_clash context (tye, T, U) =
  if Config.get_generic context Pattern.unify_trace_failure then
    let
      val ctxt = Context.proof_of context;
      val t = Syntax.string_of_typ ctxt (Envir.norm_type tye T);
      val u = Syntax.string_of_typ ctxt (Envir.norm_type tye U);
    in tracing ("The following types do not unify:\n" ^ t ^ "\n" ^ u) end
  else ();

fun event context ev =
  (case ev of
    G.Ev_Unif (G.Typ_Clash (tye, T, U)) => typ_clash context (tye, T, U)
  | _ => ());

fun raise_exn (state, orule) exn =
  (case exn of
    G.UExn (G.PExn (G.Unif _)) => raise Pattern.Unif
  | G.UExn (G.PExn G.Pattern) => raise Pattern.Pattern
  | G.UExn (G.PExn G.Match) => raise Pattern.MATCH
  | G.UExn (G.PExn G.TUnify) => raise Type.TUNIFY
  | G.UExn (G.PExn G.Type_Match) => raise Type.TYPE_MATCH
  | G.UExn (G.PExn (G.Class_Error _)) => raise Fail "bicompose: unexpected CLASS_ERROR"
  | G.UExn (G.PExn (G.Type_Error (msg, Ts, ts))) => raise TYPE (msg, Ts, ts)
  | G.UExn (G.PExn (G.Term_Error (msg, ts))) => raise TERM (msg, ts)
  | G.UExn (G.PExn (G.Failure msg)) => raise Fail msg
  | G.UExn (G.PExn G.Subscript) => raise Subscript
  | G.UExn (G.PExn G.Unequal_Lengths) => raise ListPair.UnequalLengths
  | G.UExn (G.PExn (G.Dup xi)) => raise Vartab.DUP xi
  | G.UExn G.Bind => raise Bind
  | G.UExn _ => raise Fail "bicompose: unexpected exception of the unifier"
  | G.THM (msg, i, G.Orule) => raise THM (msg, i, [orule])
  | G.THM (msg, i, G.Orule_State) => raise THM (msg, i, [orule, state])
  | G.ERROR msg => error msg
  | G.COMPOSE => raise Fail "bicompose: COMPOSE");

fun run context thms r =
  (case r of
    SOME (evs, res) =>
      (List.app (event context) evs;
        (case res of
          G.TOk x => x
        | G.TErr exn => raise_exn thms exn))
  | NONE => raise Fail "bicompose: undefined result");

fun ops context =
  G.BOps
    (fn env => fn tus => SOME ([], G.TOk (Unify.unifiers (context, env, tus))),
     fn xq => SOME ([], G.TOk (Seq.pull xq)),
     Name.variant_list []);

(*the logical content of a new theorem: proposition, flex-flex pairs, maximal index*)
type result = term * (term * term) list * int;

fun bicompose_aux ctxt {flatten, match, incremented} (state, (stpairs, Bs, Bi, C), lifted)
    (eres_flg, orule, nsubgoal) : result Seq.seq =
  let
    val context = Context.Proof ctxt;
    val ops = ops context;
    fun eval r = run context (state, orule) r;
    fun result (G.BRes (env, ntpairs, prop, _, _)) = (prop, ntpairs, Envir.maxidx_of env);
    fun to_seq s =
      Seq.make (fn () =>
        (case eval (G.bpull ops s) of
          NONE => NONE
        | SOME (res, s') => SOME (result res, to_seq s')));
    val alg = Sign.classes_of (Context.theory_of context);
  in
    to_seq (eval (G.bicompose_aux ops alg flatten match incremented
      (Thm.maxidx_of state, (Thm.tpairs_of state, Thm.prop_of state))
      (stpairs, (Bs, (Bi, C))) lifted eres_flg
      (Thm.maxidx_of orule, (Thm.tpairs_of orule, Thm.prop_of orule)) nsubgoal))
  end;

(*Thm.biresolution for a single rule*)
fun could_bires (Hs, B, eres_flg, rule) =
  let
    fun could_reshyp (A1 :: _) = exists (fn H => Term.could_unify (A1, H)) Hs
      | could_reshyp [] = false;
  in
    Term.could_unify (Thm.concl_of rule, B) andalso
    (not eres_flg orelse could_reshyp (Thm.prems_of rule))
  end;

fun biresolution ctxt match (eres_flg, rule) i state =
  let
    val (stpairs, Bs, Bi, C) = Thm.dest_state (state, i);
    val B = Logic.strip_assums_concl Bi;
    val Hs = Logic.strip_assums_hyp Bi;
  in
    if could_bires (Hs, B, eres_flg, rule) then
      bicompose_aux ctxt {flatten = true, match = match, incremented = true}
        (state, (stpairs, Bs, Bi, C), true)
        (eres_flg, Thm.lift_rule (Thm.cprem_of state i) rule, Thm.nprems_of rule)
    else Seq.empty
  end;

fun bicompose ctxt flags arg i state =
  bicompose_aux ctxt flags (state, Thm.dest_state (state, i), false) arg;

fun result_of th : result = (Thm.prop_of th, Thm.tpairs_of th, Thm.maxidx_of th);


(* comparison *)

fun exn_name exn =
  (case exn of
    Pattern.Unif => "Unif"
  | Pattern.Pattern => "Pattern"
  | Pattern.MATCH => "MATCH"
  | TYPE (msg, Ts, ts) => "TYPE " ^ msg ^ " " ^ \<^make_string> (Ts, ts)
  | TERM (msg, ts) => "TERM " ^ msg ^ " " ^ \<^make_string> ts
  | THM (msg, i, ths) => "THM " ^ msg ^ " " ^ string_of_int i ^ " " ^
      \<^make_string> (map Thm.full_prop_of ths)
  | ERROR msg => "ERROR " ^ msg
  | Fail msg => "Fail " ^ msg
  | Subscript => "Subscript"
  | ListPair.UnequalLengths => "UnequalLengths"
  | Vartab.DUP xi => "DUP " ^ \<^make_string> xi
  | Bind => "Bind"
  | exn => if Exn.is_interrupt exn then Exn.reraise exn else "other: " ^ General.exnMessage exn);

(*the first n elements of a sequence, or the exception raised*)
fun take_seq n dump xq =
  let
    fun go 0 _ acc = rev acc
      | go k xq acc =
          (case Exn.result Seq.pull xq of
            Exn.Res NONE => rev ("END" :: acc)
          | Exn.Res (SOME (x, xq')) => go (k - 1) xq' (dump x :: acc)
          | Exn.Exn exn => rev (("EXN " ^ exn_name exn) :: acc))
  in
    (case Exn.result (fn () => go n xq []) () of
      Exn.Res res => cat_lines res
    | Exn.Exn exn => "EXN " ^ exn_name exn)
  end;

fun dump_result (r: result) = \<^make_string> r;

fun outcome n f x =
  (case Exn.result f x of
    Exn.Res xq => take_seq n dump_result xq
  | Exn.Exn exn => "EXN " ^ exn_name exn);

type report =
  {name: string, tests: int, run: int, nonempty: int, exns: int,
    mismatches: (string * string option * string option) list, time: Time.time};

(*Compare the outcomes of the original (f) and the generated code (g) on each problem; the
  results of the original are theorems. A timeout is not counted as a mismatch.*)
fun compare name n show f g xs : report =
  let
    fun timed h x =
      (case Exn.result (Timeout.apply (seconds 20.0) h) x of
        Exn.Res y => SOME y
      | Exn.Exn (Timeout.TIMEOUT _) => NONE
      | Exn.Exn exn => Exn.reraise exn);
    fun run1 x =
      (show x, timed (outcome n (Seq.map result_of o f)) x, timed (outcome n g) x);
    val (time, results) = Timing.timing (map run1) xs;
    val mismatches =
      filter (fn (_, a, b) => is_some a andalso is_some b andalso a <> b) results;
    val timeouts = filter (fn (_, a, b) => not (is_some a) orelse not (is_some b)) results;
    fun first_is pre (_, a, _) =
      (case a of SOME s => String.isPrefix pre s | NONE => false);
  in
    {name = name, tests = length xs, run = length results - length timeouts,
      nonempty = length (filter (fn r => not (first_is "END" r orelse first_is "EXN" r)) results),
      exns = length (filter (first_is "EXN") results),
      mismatches = mismatches, time = #elapsed time}
  end;

fun report ({name, tests, run, nonempty, exns, mismatches, time}: report) =
  name ^ ": " ^ string_of_int tests ^ " problems, " ^ string_of_int run ^ " run, " ^
  string_of_int nonempty ^ " with results, " ^ string_of_int exns ^ " with exceptions, " ^
  string_of_int (length mismatches) ^ " mismatches; time " ^ Time.toString time ^ "s";

fun check (rs: report list) =
  if forall (null o #mismatches) rs then ()
  else error (cat_lines (map (fn r => #name r ^ ": " ^
    \<^make_string> (take 2 (#mismatches r))) rs));

fun show_problem (r, i, st) = \<^make_string> (Thm.prop_of r, i, Thm.prop_of st);


(* test data from the theorems of a theory *)

(*theorems of ancestors are transferred, so that their certificates can be joined*)
fun theorems thy n =
  Global_Theory.all_thms_of thy true
  |> map (Thm.transfer thy o snd)
  |> filter (fn th => Thm.nprems_of th > 0)
  |> take n;

fun head_key t =
  (case Term.head_of (HOLogic.dest_Trueprop t handle TERM _ => t) of
    Const (c, _) => SOME c
  | Free (x, _) => SOME x
  | _ => NONE);

fun pick xs i = nth xs (i mod length xs);

(*rules indexed by the head of their conclusion*)
fun rule_table rules =
  fold (fn th =>
    (case head_key (Thm.concl_of th) of
      SOME c => Symtab.cons_list (c, th)
    | NONE => I)) rules Symtab.empty;

(*a proof state with the proposition of a theorem as its only subgoal, with its schematic
  variables fixed*)
fun freeze t =
  t |> Term.map_aterms (fn Var ((x, i), T) => Free (x ^ "_" ^ string_of_int i, T) | u => u)
    |> Term.map_types (Term.map_atyps (fn TVar ((a, i), S) => TFree (a ^ "_" ^ string_of_int i, S)
      | T => T));

fun goal_state thy th = Goal.init (Thm.global_cterm_of thy (freeze (Thm.prop_of th)));

(*resolution problems: subgoals i of states against rules whose conclusion has the same head*)
fun res_problems tab k states =
  states |> maps (fn st =>
    map_index (fn (i, Bi) =>
      (case head_key (Logic.strip_assums_concl Bi) of
        SOME c => take k (Symtab.lookup_list tab c) |> map (fn r => (r, i + 1, st))
      | NONE => [])) (Thm.prems_of st) |> flat);

(*elim-resolution problems: subgoals with assumptions, against rules whose first premise has
  the head of an assumption, and against a few other rules with premises*)
fun eres_problems rules k states =
  let
    val tab =
      fold (fn th =>
        (case Thm.prems_of th of
          A1 :: _ => (case head_key A1 of SOME c => Symtab.cons_list (c, th) | NONE => I)
        | [] => I)) rules Symtab.empty;
    fun probs j (i, Bi) =
      let
        val Hs = Logic.strip_assums_hyp Bi;
        val matching = Hs |> maps (fn H =>
          (case head_key H of SOME c => take k (Symtab.lookup_list tab c) | NONE => []));
        val others = if null Hs then [] else [pick rules (j * 7919 + i * 31)];
      in map (fn r => (r, i + 1, nth states j)) (matching @ others) end;
  in states |> map_index (fn (j, st) => map_index (probs j) (Thm.prems_of st) |> flat) |> flat end;

(*composition without lifting: a theorem against a premise of another theorem with the same
  head, without renaming their variables apart (as in Drule.compose)*)
fun comp_problems tab k states =
  states |> maps (fn st =>
    map_index (fn (i, Bi) =>
      (case head_key Bi of
        SOME c => take k (Symtab.lookup_list tab c) |> filter (fn r => Thm.nprems_of r = 0)
          |> map (fn r => (r, i + 1, st))
      | NONE => [])) (Thm.prems_of st) |> flat);

end;
\<close>

ML \<open>
local
  val thy = \<^theory>;
  val ctxt = \<^context> |> Context_Position.set_visible false;
  val rules = Bicompose_Test.theorems thy 3000;
  val facts = Global_Theory.all_thms_of thy true |> map (Thm.transfer thy o snd) |> take 6000;
  val tab = Bicompose_Test.rule_table (rules @ facts);
  val states = take 1500 rules;
  val goals = map (Bicompose_Test.goal_state thy) (take 1500 rules);
  val res = Bicompose_Test.res_problems tab 3 (states @ goals);
  val eres = Bicompose_Test.eres_problems rules 2 (states @ goals);
  val comps = Bicompose_Test.comp_problems tab 3 states;
  fun bires match eres_flg (r, i, st) = Thm.biresolution (SOME ctxt) match [(eres_flg, r)] i st;
  fun bires' match eres_flg (r, i, st) = Bicompose_Test.biresolution ctxt match (eres_flg, r) i st;
  fun comp flags (r, i, st) = Thm.bicompose (SOME ctxt) flags (false, r, 0) i st;
  fun comp' flags (r, i, st) = Bicompose_Test.bicompose ctxt flags (false, r, 0) i st;
  val flags1 = {flatten = true, match = false, incremented = false};
  val flags2 = {flatten = false, match = true, incremented = false};
  val show = Bicompose_Test.show_problem;
  val r1 = Bicompose_Test.compare "resolution" 3 show (bires false false) (bires' false false) res;
  val r2 = Bicompose_Test.compare "resolution (match)" 3 show (bires true false) (bires' true false) res;
  val r3 = Bicompose_Test.compare "elim-resolution" 3 show (bires false true) (bires' false true) eres;
  val r4 = Bicompose_Test.compare "composition" 3 show (comp flags1) (comp' flags1) comps;
  val r5 = Bicompose_Test.compare "composition (match, no flattening)" 3 show
    (comp flags2) (comp' flags2) comps;
  (*exceptions: too few premises of the rule, elim-resolution with a rule without premises,
    and elim-resolution without lifting, where the other premises of the rule may have too
    few assumptions to delete*)
  fun gen arg flags (r, i, st) = Thm.bicompose (SOME ctxt) flags (arg r) i st;
  fun gen' arg flags (r, i, st) = Bicompose_Test.bicompose ctxt flags (arg r) i st;
  val flags3 = {flatten = true, match = false, incremented = false};
  fun too_many r = (false, r, Thm.nprems_of r + 1);
  fun no_prems r = (true, r, 0);
  fun all_prems r = (true, r, Thm.nprems_of r);
  val r6 = Bicompose_Test.compare "too many subgoals" 3 show
    (gen too_many flags3) (gen' too_many flags3) (take 300 comps);
  val r7 = Bicompose_Test.compare "elim-resolution without premises" 3 show
    (gen no_prems flags3) (gen' no_prems flags3) (take 300 comps);
  val r8 = Bicompose_Test.compare "elim-resolution without lifting" 3 show
    (gen all_prems flags3) (gen' all_prems flags3) (take 3000 eres);
  val rs = [r1, r2, r3, r4, r5, r6, r7, r8];
in
  val _ = writeln (cat_lines (map Bicompose_Test.report rs));
  val _ = Bicompose_Test.check rs;
end
\<close>

end
