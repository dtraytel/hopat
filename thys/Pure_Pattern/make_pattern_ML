#!/usr/bin/env bash
#
# Assemble a replacement for $ISABELLE_HOME/src/Pure/pattern.ML from the code generated
# in session Pure_Pattern (theory Pure_Pattern_Code) and pattern_wrapper.ML.
#
# Usage: make_pattern_ML [OUTPUT]   (default: generated/pattern.ML)

set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
OUT="${1:-$DIR/generated/pattern.ML}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

isabelle build -d "$DIR/.." -e Pure_Pattern
isabelle export -d "$DIR/.." -O "$TMP" -x "Pure_Pattern.Pure_Pattern_Code:code/**" Pure_Pattern

{
  cat <<'HEADER'
(*  Title:      Pure/pattern.ML
    Author:     Generated from the Isabelle/HOL formalization in session Pure_Pattern
                (theories Pure_Term, Pure_Envir, Pure_Pattern, Pure_Pattern_Code),
                following the original by Tobias Nipkow, Christine Heinzelmann,
                and Stefan Berghofer, TU Muenchen.

Unification of Higher-Order Patterns.

See also:
Tobias Nipkow. Functional Unification of Higher-Order Patterns.
In Proceedings of the 8th IEEE Symposium Logic in Computer Science, 1993.

DO NOT EDIT: generated by make_pattern_ML.
*)

signature PATTERN =
sig
  exception Unif
  exception Pattern
  val unify_trace_failure: bool Config.T
  val unify_types: Context.generic -> typ * typ -> Envir.env -> Envir.env
  val unify: Context.generic -> term * term -> Envir.env -> Envir.env
  exception MATCH
  val match: theory -> term * term -> Type.tyenv * Envir.tenv -> Type.tyenv * Envir.tenv
  val first_order_match: theory -> term * term
    -> Type.tyenv * Envir.tenv -> Type.tyenv * Envir.tenv
  val pattern: term -> bool
end;


(** generated code **)

HEADER
  cat "$TMP/Pure_Pattern.Pure_Pattern_Code/code/pattern_generated.ML"
  printf '\n\n(** wrapper **)\n\n'
  sed -n '/^signature PATTERN_GENERATED/,$p' "$DIR/pattern_wrapper.ML"
  cat <<'FOOTER'

structure Pattern: PATTERN =
  Pattern_Fun(val unify_trace_failure =
    Config.declare_bool ("unify_trace_failure", \<^here>) (K false));
FOOTER
} > "$OUT"

echo "Generated $OUT"
