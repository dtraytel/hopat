@article{HUET197527,
	title = "A unification algorithm for typed $\lambda$-calculus",
	journal = "Theoretical Computer Science",
	volume = "1",
	number = "1",
	pages = "27 - 57",
	year = "1975",
	issn = "0304-3975",
	doi = "https://doi.org/10.1016/0304-3975(75)90011-0",
	url = "http://www.sciencedirect.com/science/article/pii/0304397575900110",
	author = "Gerard P. Huet",
	abstract = "A semi-decision algorithm is presented, to search for unification of formulas in typed $\omega$-order $\lambda$-calculus, and its correctness is proved. It is shown that the search space is significantly smaller than the one for finding the most general unifiers. In particular, our search is not redundant. This allows our algorithm to have good directionality and convergence properties."
}

