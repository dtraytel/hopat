# HG changeset patch
single matching step for an occurring variable, avoiding cyclic environments

diff --git a/src/Pure/unify.ML b/src/Pure/unify.ML
--- a/src/Pure/unify.ML
+++ b/src/Pure/unify.ML
@@ -400,6 +400,49 @@
   in mc end;
 
 
+fun matchone context vname (rbinder, targs, u, (env, dpairs)) =
+  let
+    val uhead = head_of u;
+    val T0 = fastype env (rbinder, uhead);
+    val base = Envir.body_type env T0;
+    val Ts = map (curry (fastype env) rbinder) targs;
+    fun new (head, Us) env =
+      let val (env', args) = make_args vname (Ts, env, Us)
+      in (list_comb (head, args), (env', dpairs)) end;
+    fun proj (T, i) tail =
+      let val (Us, bary) = Envir.strip_type env T in
+        Seq.cons (new (Bound i, Us)
+          (if Config.get_generic context unify_trace_types
+           then test_unify_types context (base, bary) env
+           else unify_types context (base, bary) env)) tail
+      end handle CANTUNIFY => tail;
+    val imit =
+      (case uhead of
+        Const _ => Seq.single (new (uhead, Envir.binder_types env T0) env)
+      | Free _ => Seq.single (new (uhead, Envir.binder_types env T0) env)
+      | _ => Seq.empty);
+  in fold proj (Ts ~~ (length Ts - 1 downto 0)) imit end;
+
+
+fun add_env_vars env =
+  let
+    fun add (Var (vT as (v, _))) vs =
+          if member (op =) vs v then vs
+          else (case Envir.lookup env vT of NONE => v :: vs | SOME t => add t (v :: vs))
+      | add (t $ u) vs = add t (add u vs)
+      | add (Abs (_, _, t)) vs = add t vs
+      | add _ vs = vs;
+  in add end;
+
+fun connected env ts dpairs =
+  let
+    fun vars ts = filter_out (Vartab.defined (Envir.term_env env)) (fold (add_env_vars env) ts []);
+    fun close vs (ps, qs) =
+      (case List.partition (exists (member (op =) vs) o snd) qs of
+        ([], _) => (map fst ps, map fst qs)
+      | (ps', qs') => close (fold (union (op =) o snd) ps' vs) (ps @ ps', qs'));
+  in close (vars ts) ([], map (fn dp as (_, t, u) => (dp, vars [u, t])) dpairs) end;
+
 (*Call matchcopy to produce assignments to the variable in the dpair*)
