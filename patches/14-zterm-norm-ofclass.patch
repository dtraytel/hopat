# HG changeset patch
normalize the types of class memberships in tight terms, like Envir.norm_term

diff --git a/src/Pure/zterm.ML b/src/Pure/zterm.ML
--- a/src/Pure/zterm.ML
+++ b/src/Pure/zterm.ML
@@ -886,6 +886,7 @@
              ZAbs (_, _, body) => Same.commit norm (subst_term_bound t body)
            | nf => ZApp (nf, Same.commit norm t))
           handle Same.SAME => ZApp (f, norm t))
+      | norm (OFCLASS (T, c)) = OFCLASS (normT T, c)
       | norm _ = raise Same.SAME;
   in fn t => if Envir.is_empty envir then beta_norm_term_same t else norm t end;
 
