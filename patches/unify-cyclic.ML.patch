+(*Single step of matchcopy: projections and imitation, keeping the dpairs*)
+fun matchone context vname (rbinder, targs, u, (env, dpairs)) =
+  let
+    val unify_trace_types = Config.get_generic context unify_trace_types;
+    val uhead = head_of u;
+    val T0 = fastype env (rbinder, uhead);
+    val base = Envir.body_type env T0;
+    val Ts = map (curry (fastype env) rbinder) targs;
+    fun new (head, Us) env =
+      let val (env', args) = make_args vname (Ts, env, Us)
+      in (list_comb (head, args), (env', dpairs)) end;
+    fun projenv (head, (Us, bary), tail) =
+      let
+        val env =
+          if unify_trace_types then test_unify_types context (base, bary) env
+          else unify_types context (base, bary) env
+      in Seq.cons (new (head, Us) env) tail end
+      handle CANTUNIFY => tail;
+    fun make_projs (T::Ts, _::targs) = (Bound(length Ts), T) :: make_projs (Ts,targs)
+      | make_projs ([],[]) = []
+      | make_projs _ = raise TERM ("make_projs", u::targs);
+    val projs = rev (make_projs (Ts, targs));
+    val imit =
+      (case uhead of
+        Const _ => Seq.single (new (uhead, Envir.binder_types env T0) env)
+      | Free _ => Seq.single (new (uhead, Envir.binder_types env T0) env)
+      | _ => Seq.empty);
+    fun matchfun ((bvar, T) :: projs) = projenv (bvar, Envir.strip_type env T, matchfun projs)
+      | matchfun [] = imit;
+  in matchfun projs end;
+
+
