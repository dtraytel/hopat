# HG changeset patch
delete arguments of flex-flex pairs only if all arguments are rigid-headed

diff --git a/src/Pure/unify.ML b/src/Pure/unify.ML
--- a/src/Pure/unify.ML
+++ b/src/Pure/unify.ML
@@ -473,9 +473,9 @@
       | change lev t = t;
   in change 0 end;
 
-(*Change indices, delete the argument if it contains a banned Bound*)
-fun change_arg banned {j, t, T} args : flarg list =
-  if rigid_bound (0, banned) t then args  (*delete argument!*)
+(*Change indices, delete the argument if del and it contains a banned Bound*)
+fun change_arg del banned {j, t, T} args : flarg list =
+  if del andalso rigid_bound (0, banned) t then args  (*delete argument!*)
   else {j = j, t = change_bnos banned t, T = T} :: args;
 
 
@@ -506,7 +506,10 @@
     val (Var (v, T), ts) = strip_comb t;
     val (Ts, U) = Envir.strip_type env T
     and js = length ts - 1  downto 0;
-    val args = sort_args (fold_rev (change_arg banned) (flexargs (js, ts, Ts)) [])
+    val del =
+      forall (fn t =>
+        (case head_of (Envir.eta_contract t) of Var _ => false | Abs _ => false | _ => true)) ts;
+    val args = sort_args (fold_rev (change_arg del banned) (flexargs (js, ts, Ts)) [])
     val ts' = map #t args;
   in
     if decreasing (length Ts) args then (env, (list_comb (Var (v, T), ts')))
