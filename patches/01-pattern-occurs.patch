# HG changeset patch
occurs check in pattern unification: fail only on patterns, otherwise give up

diff --git a/src/Pure/pattern.ML b/src/Pure/pattern.ML
--- a/src/Pure/pattern.ML
+++ b/src/Pure/pattern.ML
@@ -122,6 +122,14 @@
 
 fun ints_of' env ts = ints_of (map (Envir.head_norm env) ts);
 
+fun pattern (Abs (_, _, t)) = pattern t
+  | pattern t =
+      let val (head, args) = strip_comb t in
+        if is_Var head then
+          forall is_Bound args andalso not (has_duplicates (op aconv) args)
+        else forall pattern args
+      end;
