@@ -122,6 +122,17 @@
 
 fun ints_of' env ts = ints_of (map (Envir.head_norm env) ts);
 
+(*F occurs as the head of a pattern F x1 ... xn, reached modulo head normalisation through
+  abstractions and arguments of rigid heads: such an occurrence survives in every instance*)
+fun rigid_occurs (F, t, env) =
+  (case Envir.head_norm env t of
+    Abs (_, _, u) => rigid_occurs (F, u, env)
+  | t' =>
+      (case strip_comb t' of
+        (Var (G, _), ts) => F = G andalso ((ints_of' env ts; true) handle Pattern => false)
+      | (Abs _, _) => false
+      | (_, ts) => exists (fn u => rigid_occurs (F, u, env)) ts));
+
 
 fun app (s,(i::is)) = app (s$Bound(i),is)
   | app (s,[])      = s;
